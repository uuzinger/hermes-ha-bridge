# Copy to bridge.env and chmod 600 — this holds a credential.

# Must match the Authorization value in HA secrets.yaml, minus the "Bearer "
# prefix (HA's secret includes the scheme; this variable does not).
HERMES_BRIDGE_TOKEN=CHANGEME_openssl_rand_hex_32

# The webhook_id here must match hermes_reply_webhook_id in HA secrets.yaml.
HA_WEBHOOK_URL=http://ha.zinger.org:8123/api/webhook/CHANGEME_openssl_rand_hex_16

# Devices permitted to submit. Anything else gets 403.
ALLOWED_DEVICES=zeds_office

# Absolute path if `hermes` is not on PATH for the service user.
#HERMES_BIN=/home/zinger/.local/bin/hermes

# --- Tool policy -----------------------------------------------------------
# Empty means voice runs inherit config.yaml defaults, which includes terminal.
# See README "Tool policy" before setting this — unknown names only warn, so a
# typo silently leaves you unrestricted.
#TOOLSETS=

# --- Tuning ----------------------------------------------------------------
#MAX_TURNS=12
#RUN_BUDGET=120
#THREAD_BUCKET=daily        # daily | hourly | none
#MAX_CONCURRENT=2
#DEDUP_WINDOW=10

# Leave REASONING unset. `low` made this model print literal tool-call syntax
# instead of calling tools, returning no answer.
#REASONING=
